# ─── DATABASE CONFIG ──────────────────────────────────
POSTGRES_DB=dailylover
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_postgres_password
DATABASE_URL=postgresql+asyncpg://postgres:your_secure_postgres_password@postgres:5432/dailylover

# ─── CACHE & QUEUE CONFIG ─────────────────────────────
REDIS_PASSWORD=your_secure_redis_password
REDIS_URL=redis://:your_secure_redis_password@redis:6379/0

# ─── TRAEFIK SECURITY ─────────────────────────────────
# Generate basic auth hash for Traefik dashboard
# Example format: admin:$apr1$xyz...
TRAEFIK_AUTH=admin:hash_here
JWT_SECRET_KEY=your_jwt_secret_key_here # Secret key used to sign JWT authentication tokens (generate with: openssl rand -hex 32)

# ─── AI SERVICES (CLAUDE & OPENAI) ────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
DEMO_MODE=false # Set to true to disable real Claude/OpenAI calls and use realistic simulated responses for demos

# ─── WHATSAPP BUSINESS API ────────────────────────────
WHATSAPP_API_TOKEN=your_whatsapp_api_token_here
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id_here
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your_custom_webhook_verify_token_here

# ─── AWS S3 BACKUPS ───────────────────────────────────
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
AWS_S3_BUCKET=your_s3_bucket_name_here
AWS_DEFAULT_REGION=us-east-1
